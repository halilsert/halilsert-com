<style>
		.tdsb-wrap{width:100%;max-width:1500px;margin:20px auto;padding:0 18px}
		.tdsb-head{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(320px,0.8fr);gap:16px;align-items:end;margin-bottom:18px}
		.tdsb-head-copy{display:grid;gap:8px}
		.tdsb-eyebrow{display:inline-flex;align-items:center;justify-content:center;width:max-content;min-height:34px;padding:0 14px;border-radius:999px;background:#fff3ea;color:#e85002;font-size:12px;font-weight:900;letter-spacing:.2px;text-transform:uppercase}
		.tdsb-title{margin:0;font-size:34px;line-height:1.05;font-weight:1000;color:#111827}
		.tdsb-sub{margin:0;color:#667085;font-size:15px;line-height:1.7;font-weight:700}
		.tdsb-head-actions{display:grid;gap:10px}
		.tdsb-search{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:8px}
		.tdsb-search input{min-height:42px;padding:0 14px;border:1px solid rgba(232,80,2,.22);border-radius:14px;background:#fff}
		.tdsb-search button,.tdsb-search a,.tdsb-btn{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 14px;border-radius:14px;text-decoration:none!important;font-weight:900;font-size:14px}
		.tdsb-search button,.tdsb-btn{border:0;background:linear-gradient(135deg,#f16001,#e85002);color:#fff!important}
		.tdsb-search a{border:1px solid rgba(232,80,2,.18);background:#fff;color:#111827!important}
		.tdsb-filterbar{display:grid;gap:12px;margin:0 0 18px}
		.tdsb-filter-group{display:grid;gap:8px}
		.tdsb-filter-title{font-size:12px;font-weight:1000;text-transform:uppercase;letter-spacing:.22px;color:#667085}
		.tdsb-filter-pills{display:flex;gap:8px;flex-wrap:wrap}
		.tdsb-filter-pill{display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:0 12px;border-radius:999px;border:1px solid #ead8ca;background:#fff;color:#111827!important;text-decoration:none!important;font-size:12px;font-weight:900;white-space:nowrap}
		.tdsb-filter-pill.is-active{background:#111827;border-color:#111827;color:#fff!important}
		.tdsb-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:18px}
		.tdsb-stat-card{padding:16px;border:1px solid #f4ddce;border-radius:20px;background:#fff;box-shadow:0 12px 30px rgba(0,0,0,.04)}
		.tdsb-stat-label{display:block;margin-bottom:8px;color:#667085;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.2px}
		.tdsb-stat-card strong{font-size:28px;line-height:1;font-weight:1000;color:#111827}
		.tdsb-empty{padding:18px;border:1px dashed rgba(232,80,2,.24);border-radius:18px;background:#fffaf5;color:#667085;font-size:14px;font-weight:800}
		.tdsb-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px}
		.tdsb-card{display:flex;flex-direction:column;gap:12px;padding:12px;border:1px solid #f4ddce;border-radius:24px;background:#fff;box-shadow:0 16px 34px rgba(0,0,0,.05);min-width:0;height:100%}
		.tdsb-card.is-recent{background:linear-gradient(180deg,#fff7f6 0%,#fff 100%);border-color:rgba(220,38,38,.20);box-shadow:0 16px 34px rgba(220,38,38,.08)}
		.tdsb-card-top{display:flex;flex-direction:column;gap:10px;align-items:stretch;height:100%}
		.tdsb-thumb{width:100%;aspect-ratio:1/1;border-radius:18px;overflow:hidden;background:#fff7f5;border:1px solid #f0e2d8}
		.tdsb-thumb img{width:100%;height:100%;object-fit:cover}
		.tdsb-card-copy{display:grid;gap:6px;min-width:0;flex:1;text-align:center}
		.tdsb-recent-pill{display:inline-flex;align-items:center;justify-content:center;width:max-content;min-height:28px;padding:0 10px;border-radius:999px;background:#fee2e2;color:#b91c1c;font-size:11px;font-weight:1000}
		.tdsb-recent-pill{margin:0 auto}
		.tdsb-name{margin:0;font-size:17px;line-height:1.25;font-weight:1000;color:#111827;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
		.tdsb-meta{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;color:#667085;font-size:11px;font-weight:800}
		.tdsb-oos-date{color:#475467;font-size:12px;font-weight:800}
		.tdsb-card-bottom{display:flex;justify-content:stretch;margin-top:auto}
		.tdsb-link{display:inline-flex;align-items:center;justify-content:center;min-height:40px;width:100%;padding:0 16px;border-radius:14px;background:#111827;color:#fff!important;text-decoration:none!important;font-weight:900}
		.tdsb-pagination{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;margin:18px 0 8px}
		.tdsb-pg{display:inline-flex;align-items:center;justify-content:center;min-width:42px;height:42px;padding:0 14px;border-radius:14px;border:1px solid #ead8ca;background:#fff;color:#111827!important;text-decoration:none!important;font-weight:900}
		.tdsb-pg.is-active{background:#111827;border-color:#111827;color:#fff!important}
		.tdsb-pg.is-disabled{opacity:.45;pointer-events:none}
		.tdsb-note-pill{display:inline-flex;align-items:center;justify-content:center;width:max-content;min-height:28px;padding:0 10px;border-radius:999px;background:#f6f0ea;color:#475467;font-size:11px;font-weight:900;margin:0 auto}
		.tdsb-price-pill{display:inline-flex;align-items:center;justify-content:center;width:max-content;min-height:30px;padding:0 12px;border-radius:999px;background:#fff4eb;color:#e85002;font-size:12px;font-weight:1000;margin:0 auto}
		.tdsb-card.is-view-restock{border-color:rgba(34,197,94,.18);background:linear-gradient(180deg,#f6fff9 0%,#fff 100%)}
		.tdsb-card.is-view-restock.is-recent{box-shadow:0 16px 34px rgba(34,197,94,.10)}
		.tdsb-card.is-view-restock .tdsb-recent-pill{background:#dcfce7;color:#166534}
		.tdsb-card.is-view-price{border-color:rgba(59,130,246,.18);background:linear-gradient(180deg,#f7fbff 0%,#fff 100%)}
		.tdsb-card.is-view-price.is-recent{box-shadow:0 16px 34px rgba(59,130,246,.10)}
		.tdsb-card.is-view-price .tdsb-recent-pill{background:#dbeafe;color:#1d4ed8}
		.tdsb-float{position:fixed;top:50%;right:max(14px,calc((100vw - 1500px)/2 + 14px));bottom:auto;transform:translateY(-50%);z-index:99999;display:flex;flex-direction:column;gap:8px;align-items:flex-end}
		.tdsb-float-links{display:flex;flex-direction:column;gap:8px;padding:0;background:transparent;border:0;border-radius:0;box-shadow:none;backdrop-filter:none}
		.tdsb-float-toggle{display:none;position:relative;width:48px;height:48px;border-radius:50%;border:0;background:#111827;color:#fff;cursor:pointer;box-shadow:0 10px 24px rgba(15,23,42,.28);align-items:center;justify-content:center;font-size:20px;line-height:1;-webkit-tap-highlight-color:transparent}
		.tdsb-float-toggle-badge{position:absolute;top:-4px;right:-4px;min-width:20px;height:20px;padding:0 5px;border-radius:999px;background:#e85002;color:#fff;border:2px solid #fff;display:inline-flex;align-items:center;justify-content:center;font-size:10px;font-weight:1000;line-height:1}
		.tdsb-float-toggle-badge[data-empty="1"]{display:none}
		.tdsb-float-link{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;width:62px;min-height:62px;padding:8px 6px;border-radius:18px;background:#fff;color:#111827!important;text-decoration:none!important;font-size:10px;font-weight:1000;line-height:1.1;text-align:center;border:1px solid rgba(17,24,39,.08);box-shadow:0 8px 18px rgba(15,23,42,.12);transition:transform .18s ease,box-shadow .18s ease,background .18s ease,color .18s ease,border-color .18s ease;-webkit-tap-highlight-color:transparent}
		.tdsb-float-link:hover{transform:translateX(-3px);box-shadow:0 14px 24px rgba(15,23,42,.18)}
		.tdsb-float-icon{font-size:22px;line-height:1;display:block}
		.tdsb-float-tip{font-size:9px;font-weight:900;letter-spacing:.2px;text-transform:uppercase;opacity:.85}
		.tdsb-float-link.is-tone-restock{background:linear-gradient(180deg,#ff7a1a 0%,#e85002 100%);color:#fff!important;border-color:transparent}
		.tdsb-float-link.is-tone-oos{background:#111827;color:#fff!important;border-color:transparent}
		.tdsb-float-link.is-tone-price{background:#fff;color:#e85002!important;border-color:rgba(232,80,2,.22)}
		.tdsb-float-link.is-current{transform:translateX(-5px);box-shadow:0 16px 26px rgba(15,23,42,.2);outline:2px solid rgba(255,255,255,.85)}
		.tdsb-float-link.is-current.is-tone-price{background:#111827;color:#fff!important;border-color:#111827}
		.tdsb-float-link.is-alert{animation:tdsbPulse 1.85s infinite}
		.tdsb-badge{position:absolute;top:-7px;right:-7px;min-width:22px;height:22px;padding:0 6px;border-radius:999px;background:#111827;color:#fff;border:2px solid #fff;display:inline-flex;align-items:center;justify-content:center;font-size:10.5px;font-weight:1000;box-shadow:0 6px 14px rgba(0,0,0,.18);line-height:1}
		.tdsb-badge[data-empty="1"]{display:none}
		.tdsb-float-link.is-tone-restock .tdsb-badge{background:#111827}
		.tdsb-float-link.is-tone-oos .tdsb-badge{background:#ff5a36}
		.tdsb-float-link.is-tone-price .tdsb-badge{background:#e85002}
		@keyframes tdsbPulse{0%{transform:scale(1);box-shadow:0 8px 18px rgba(15,23,42,.12),0 0 0 0 rgba(232,80,2,.24)}70%{transform:scale(1.05);box-shadow:0 14px 24px rgba(15,23,42,.18),0 0 0 12px rgba(232,80,2,0)}100%{transform:scale(1);box-shadow:0 8px 18px rgba(15,23,42,.12),0 0 0 0 rgba(232,80,2,0)}}
		@media(max-width:1560px){.tdsb-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
		@media(max-width:1280px){.tdsb-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
		@media(max-width:1024px){.tdsb-head{grid-template-columns:1fr}.tdsb-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.tdsb-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
		@media(max-width:768px){
			.tdsb-wrap{padding:0 12px}
			.tdsb-search{grid-template-columns:1fr}
			.tdsb-stats{grid-template-columns:1fr}
			.tdsb-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
			.tdsb-name{font-size:15px}
			/* Mobile: tiny FAB cluster bottom-right, expandable */
			.tdsb-float{right:12px;left:auto;top:auto;bottom:14px;transform:none;flex-direction:column-reverse;gap:8px;align-items:flex-end}
			.tdsb-float-toggle{display:inline-flex}
			.tdsb-float[data-collapsed="1"] .tdsb-float-link{opacity:0;pointer-events:none;transform:scale(.5) translateY(8px);transition:transform .2s ease,opacity .2s ease}
			.tdsb-float[data-collapsed="0"] .tdsb-float-link{opacity:1;pointer-events:auto;transform:scale(1) translateY(0);transition:transform .25s cubic-bezier(.18,.89,.32,1.28),opacity .2s ease}
			.tdsb-float-link{width:54px;min-height:54px;padding:6px 4px;border-radius:16px;font-size:9px;gap:1px}
			.tdsb-float-icon{font-size:19px}
			.tdsb-float-tip{font-size:8px}
			.tdsb-badge{top:-6px;right:-6px;min-width:19px;height:19px;font-size:9.5px}
		}
		@media(max-width:560px){.tdsb-grid{grid-template-columns:1fr}}
		@media(max-width:380px){
			.tdsb-float{right:10px;bottom:12px}
			.tdsb-float-toggle{width:44px;height:44px;font-size:18px}
			.tdsb-float-link{width:50px;min-height:50px;border-radius:14px}
			.tdsb-float-icon{font-size:17px}
		}
		</style>	<style id="td-mobile-polish-css">
		/* 2.a) Badge konum override — eski .outofstock::before kuralını ezeriz */
		.woocommerce ul.products li.product.outofstock::before,
		.woocommerce-page ul.products li.product.outofstock::before,
		.products .product.outofstock::before,
		.product-grid-item.outofstock::before,
		.type-product.outofstock::before {
			top: 8px !important;
			left: 8px !important;
			right: auto !important;
			z-index: 9 !important;
			min-height: 22px !important;
			padding: 0 9px !important;
			font-size: 10px !important;
			letter-spacing: .15px !important;
			background: #fee2e2 !important;
			color: #b91c1c !important;
			border-radius: 999px !important;
			box-shadow: 0 4px 12px rgba(220,38,38,.16) !important;
			max-width: calc(100% - 16px);
			pointer-events: none;
		}

		/* 2.b) Title'ın badge'in altına itilmesi için resim alanına min-yükseklik
		   ve title üstüne hafif boşluk veriyoruz (badge resim üstüne biner). */
		.woocommerce ul.products li.product.outofstock .product-thumbnail,
		.woocommerce ul.products li.product.outofstock .product-image,
		.products .product.outofstock .product-thumbnail,
		.products .product.outofstock .product-image,
		.product-grid-item.outofstock .product-thumbnail,
		.product-grid-item.outofstock .product-image {
			position: relative;
		}

		/* 2.c) Mobilde badge daha kompakt */
		@media (max-width: 480px) {
			.woocommerce ul.products li.product.outofstock::before,
			.woocommerce-page ul.products li.product.outofstock::before,
			.products .product.outofstock::before,
			.product-grid-item.outofstock::before,
			.type-product.outofstock::before {
				top: 6px !important;
				left: 6px !important;
				min-height: 20px !important;
				padding: 0 7px !important;
				font-size: 9px !important;
			}
		}

		/* 2.d) Search-clean v2 kart badge'i — başlık üzerine binmesin */
		.td-search-clean-v2-card.is-out-of-stock::before {
			align-self: flex-start;
			margin-bottom: 8px !important;
			background: #fee2e2 !important;
			color: #b91c1c !important;
		}

		/* ============================================================
		 *  3) Genel mobil cilalama
		 * ============================================================ */
		@media (max-width: 480px) {
			html, body { max-width: 100vw; overflow-x: hidden; }

			/* Yatay scroll tetikleyen sık karşılaşılan WooCommerce öğeleri */
			.woocommerce .products,
			.woocommerce-page .products,
			.woocommerce-cart-form,
			.woocommerce-checkout {
				max-width: 100% !important;
				overflow-x: hidden;
			}

			/* Ürün kartlarındaki başlıkların kesilmesini önle */
			.woocommerce ul.products li.product .woocommerce-loop-product__title,
			.woocommerce-page ul.products li.product .woocommerce-loop-product__title,
			.products .product .woocommerce-loop-product__title,
			.product-grid-item .woocommerce-loop-product__title {
				font-size: 13px !important;
				line-height: 1.3 !important;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
				min-height: 2.6em;
			}

			/* Cart, Checkout butonlarının taşmaması */
			.button, .wc-block-components-button {
				max-width: 100%;
				white-space: normal;
			}
		}

		/* 4) Misafir kullanıcı için "kilit" panelini gizle (eğer eski plugin
		      yine de çıkartırsa) */
		body.td-product-guest-open .td-product-access-box { display: none !important; }
	</style>
	</head>
<body id="blog" class="error404 wp-embed-responsive wp-theme-teknodayim-theme theme-teknodayim-theme woocommerce-no-js td-theme td-theme-footer-on">
