		<div class="td-soft-actions">
			<a class="td-soft-action is-account" href="https://www.teknodayim.com/hesabim/" aria-label="Hesabım" title="Hesabım">
				<span class="td-soft-icon"><svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/></svg></span>
